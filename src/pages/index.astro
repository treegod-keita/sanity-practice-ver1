---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Feature from "@/components/Feature/index.astro";
---

<Layout>
    <Hero />
    <section class="w-full border-t-3 border-blue-600" id="pick-up">
        <Feature />
    </section>
    <section class="h-screen w-full border-t-3 border-red-600 pt-25" id="feature"></section>
    <section class="h-screen w-full border-t-3 border-green-600 pt-25" id="contact"></section>
</Layout>
