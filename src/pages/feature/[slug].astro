---
import Layout from "@/layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import type { Feature } from "@/types/Feature";
import { FEATURE_LIST_QUERY } from "@/sanity/queries/feature";
import { PortableText as PortableTextInternal } from "astro-portabletext";
import PortableTextImage from "@/components/PortableTextImage.astro";
// ./src/pages/feature/[slug].astro

export async function getStaticPaths() {
    const features = await sanityClient.fetch<Feature[]>(FEATURE_LIST_QUERY);

    return features.map(({ slug }) => {
        return {
            params: {
                slug: slug.current,
            },
        };
    });
}
const { slug } = Astro.params;

const feature = await sanityClient.fetch<Feature>(
    `*[_type == "feature" && slug.current == $slug][0]`,
    { slug },
);
---

<Layout>
    <div class="inner pt-25">
        <h1 class="text-4xl font-bold">{feature.title}</h1>
        <div class="border-content mt-15 rounded-2xl border border-gray-600 px-20 py-10">
            <div
                class="[&_a]:text-green-400 [&_h2]:text-3xl [&_h3]:text-2xl [&_h3]:font-bold [&_p]:mt-6"
            >
                <PortableTextInternal
                    value={feature.contents}
                    components={{ type: { image: PortableTextImage } }}
                />
            </div>
        </div>
    </div>
</Layout>
