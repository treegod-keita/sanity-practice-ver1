---
import { sanityClient } from "sanity:client";
import Card from "@/components/Feature/card.astro";
import type { Feature } from "@/types/Feature";
import { intersection } from "astro:schema";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;

const FEATURE_QUERY = `*[_type == "feature"] | order(title desc)[0...12]{_id, title, image, slug, publishedAt, "tags": tags[]->{_id, name}}`;

const features = await sanityClient.fetch<Feature[]>(FEATURE_QUERY);
---

<div class=`container mx-auto min-h-screen max-w-7xl px-10 box-content pt-25 ${className}`>
    <div class="mt-7.5">
        <h2 class="mx-auto w-fit text-4xl">Feature</h2>
        <ul class="mt-15 grid grid-cols-1 gap-6.5 md:grid-cols-3">
            {features.map((feature) => <Card feature={feature} />)}
        </ul>
    </div>
</div>
